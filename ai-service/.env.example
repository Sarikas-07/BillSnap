# --- Server ---
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Comma-separated list of allowed origins (Node backend + Next.js frontend)
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000

# Path to the tesseract binary. Usually auto-detected on Linux/Mac if
# tesseract-ocr is installed system-wide. On Windows, set the full path,
# e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Shared secret the Node backend must send (optional, extra defense-in-depth
# on top of the Node layer already being the only public-facing service)
AI_SERVICE_API_KEY=
