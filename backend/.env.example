# --- Server ---
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (Stage 1 Next.js app)
CLIENT_URL=http://localhost:3000

# --- MongoDB Atlas ---
# Create a free cluster at https://www.mongodb.com/cloud/atlas
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/billsnap?retryWrites=true&w=majority
MONGO_URI=your_mongodb_atlas_connection_string

# --- JWT ---
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Cloudinary ---
# From https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Python FastAPI AI service (Stage 2 billsnap-ai) ---
AI_SERVICE_URL=http://localhost:8000
